{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote",
    "requireCommit": true
  },
  "build": {
    "apk": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "ipa": {
      "distribution": "internal",
      "ios": {
        "buildConfiguration": "Release"
      }
    },
    "android-store": {
      "distribution": "store",
      "android": {
        "buildType": "app-bundle"
      }
    },
    "ios-store": {
      "distribution": "store",
      "ios": {
        "buildConfiguration": "Release"
      }
    }
  },
  "submit": {
    "android-store": {
      "android": {
        "track": "internal"
      }
    },
    "ios-store": {
      "ios": {}
    }
  }
}
